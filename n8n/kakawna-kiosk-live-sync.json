      "typeVersion": 2.2,
      "position": [
        660,
        280
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a53b0517-4cfc-437b-b467-34e2f0d367b3",
              "leftValue": "={{ $json.rowCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "31bdcd65-71de-4e0f-927b-974be9cc3c02",
      "name": "One item per row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per row (entries and draws), each tagged with its Zoho worksheet.\nreturn $input.first().json.rows.map(r => ({ json: r }));"
      }
    },
    {
      "id": "cfa328ad-d74d-4a8e-a7fd-c8d306b66319",
      "name": "Zoho: update row by id",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "https://sheet.zoho.com/api/v2/PASTE-ZOHO-WORKBOOK-RESOURCE-ID",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "method",
              "value": "worksheet.records.update"
            },
            {
              "name": "worksheet_name",
              "value": "={{ $json.sheet }}"
            },
            {
              "name": "criteria",
              "value": "={{ '\"id\"=\"' + $json.row.id.replace(/\"/g, '') + '\"' }}"
            },
            {
              "name": "data",
              "value": "={{ JSON.stringify($json.row) }}"
            },
            {
              "name": "first_match_only",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "oAuth2Api": {
          "id": "5JbSMesPs2WXcB9m",
          "name": "Unnamed credential"
        }
      }
    },
    {
      "id": "095a48d9-8467-4e9e-93c7-9d7e03e2497b",
      "name": "Which rows are new?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Pair each Zoho update result with the row it was for (same order).\n// A row that matched nothing is new and must be added. Any Zoho failure stops the run,\n// so the webhook does not reply OK and the kiosk keeps the batch and retries later.\nconst results = $input.all();\nconst rows = $('One item per row').all();\nconst toAdd = { Entries: [], Draws: [] };\nresults.forEach((res, i) => {\n  const r = res.json || {};\n  if (r.status !== 'success') throw new Error('Zoho update failed: ' + JSON.stringify(r).slice(0, 300));\n  if (!(Number(r.no_of_affected_rows) > 0)) toAdd[rows[i].json.sheet].push(rows[i].json.row);\n});\nconst groups = Object.entries(toAdd).filter(([, list]) => list.length).map(([sheet, list]) => ({ sheet, rows: list }));\nreturn [{ json: { groups, addCount: groups.length } }];"
      }
    },
    {
      "id": "3db4e26d-bc1c-4586-9058-c8ddc0b91dfc",
      "name": "Any new rows?",
