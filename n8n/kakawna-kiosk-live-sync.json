              "value": "={{ JSON.stringify($json.rows) }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "oAuth2Api": {
          "id": "5JbSMesPs2WXcB9m",
          "name": "Unnamed credential"
        }
      }
    },
    {
      "id": "a1b2c3d4-0000-4000-8000-000000000004",
      "name": "Check adds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Make sure Zoho accepted every add; otherwise fail so the kiosk retries.\nfor (const res of $input.all()) {\n  if ((res.json || {}).status !== 'success') throw new Error('Zoho add failed: ' + JSON.stringify(res.json).slice(0, 300));\n}\nreturn [{ json: { ok: true } }];"
      }
    },
    {
      "id": "a1b2c3d4-0000-4000-8000-000000000003",
      "name": "Reply: ok",
