              "id": "4d2da80a-1b18-4905-881a-85bec352b469",
              "leftValue": "={{ $json.addCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0000-4000-8000-000000000001",
      "name": "One item per worksheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        100
