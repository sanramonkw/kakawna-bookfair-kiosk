{
  "name": "Kakawna kiosk: live entries to Zoho Sheet",
  "nodes": [
    {
      "id": "8cd5c872-736a-4390-8041-fe76c5ed88c6",
      "name": "Kiosk webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "beca7473-8992-4ca8-b08d-4a16d65d57be",
      "parameters": {
        "httpMethod": "POST",
        "path": "kakawna-kiosk",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*",
          "rawBody": true
        }
      }
    },
    {
      "id": "52e975f1-a094-4b8b-8c76-7f9de88a93be",
      "name": "Parse and check token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Kakawna kiosk batch: parse the body and check the secret token.\n// Set SECRET to the same value as \"Secret token\" in the kiosk's staff panel (Backup section).\nconst SECRET = 'CHANGE-ME-long-random-token';\n\nconst item = $input.first();\nlet body = item.json.body;\n\n// The kiosk sends JSON as text/plain (no CORS preflight), so the body may arrive\n// as an object, as a string, or only as raw binary data, depending on the n8n version.\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = null; } }\nif ((!body || !body.source) && item.binary && item.binary.data) {\n  try { body = JSON.parse((await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8')); }\n  catch (e) { body = null; }\n}\n\nconst ok = !!body && body.source === 'kbykakawna-kiosk' && body.token === SECRET;\nconst receivedAt = new Date().toISOString();\nconst deviceId = ok ? String(body.deviceId || '') : '';\nconst yesNo = v => (v ? 'yes' : 'no');\n// Visitor text that starts like a formula (=, +, @) is stored as plain text, never run as a formula.\nconst safe = v => { const s = String(v == null ? '' : v).replace(/[\\r\\n]+/g, ' '); return /^[=+@]/.test(s) ? \"'\" + s : s; };\n\nconst rows = [];\nif (ok && Array.isArray(body.entries)) for (const e of body.entries) {\n  if (!e || !e.id) continue;\n  rows.push({ sheet: 'Entries', row: {\n    id: String(e.id), ts: String(e.ts || ''), name: safe(e.name), phone: String(e.phone || ''),\n    quote: safe(e.quote), language: String(e.language || ''),\n    hidden: yesNo(e.hidden), disqualified: yesNo(e.disqualified), deviceId, receivedAt } });\n}\nif (ok && Array.isArray(body.draws)) for (const d of body.draws) {\n  if (!d || !d.id) continue;\n  rows.push({ sheet: 'Draws', row: {\n    id: String(d.id), ts: String(d.ts || ''), name: safe(d.name), phone: String(d.phone || ''),\n    quote: safe(d.quote), entryId: String(d.entryId || ''), poolSize: String(Number(d.poolSize) || 0),\n    deviceId, receivedAt } });\n}\n\nreturn [{ json: { ok, rows, rowCount: rows.length } }];"
      }
    },
    {
      "id": "33df2ad7-683b-47b4-a294-0b32b2d37ccb",
      "name": "Token OK?",
